# R-15 / ADR-020. EnforceCodeStyleInBuild (ADR-010) turns every rule below set to `warning` into a build
# error, because TreatWarningsAsErrors is on. Raising a rule's severity is therefore a build-breaking change
# for every violating file at once: do it in its own PR, with its own reformat commit.
root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
# end_of_line is deliberately unset: git owns line endings (.gitattributes, core.autocrlf).
# charset is deliberately unset: .cs files are split between UTF-8 with and without BOM.

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

# Guidance for editors only: nothing enforces formatting for the frontend (QUAL-05).
[*.{ts,tsx,js,json,css,html}]
indent_size = 2

[*.{csproj,props,targets,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Enforced: formatting. The csharp_* formatting options are left at their .NET defaults, which the code
# already follows (Allman braces, standard spacing).
dotnet_diagnostic.IDE0055.severity = warning

# Enforced: unused using directives. Only reported during a build because Directory.Build.props sets
# GenerateDocumentationFile — see the comment there.
dotnet_diagnostic.IDE0005.severity = warning

# Enforced: file-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Documented, not enforced: `var` everywhere.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# EF Core generates migrations with block-scoped namespaces. Without this, every
# `dotnet ef migrations add` would fail the build on IDE0161.
[**/Migrations/*.cs]
generated_code = true
